client
dev tun
proto udp
remote 15.235.***.*** 1194
remote 15.235.***.*** 1195
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
cipher AES-128-GCM
ignore-unknown-option block-outside-dns
remote-random
connect-retry 0
<ca>
...REDACTED...
</ca>
<cert>
...REDACTED...
</cert>
<key>
...REDACTED...
</key>
<tls-crypt>
...REDACTED...
</tls-crypt>
